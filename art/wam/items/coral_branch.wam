# Branching Coral — staghorn, the loud one.
#
# This is the centrepiece of the reef set, and it has exactly one job the other
# corals do not: **break the horizon of the seabed**. A brain coral is a lump
# and a fan is a plane, so if the reef is to read as a structure rather than as
# decoration on sand, something has to be forking upward out of it. Everything
# below serves that.
#
# **Forks, not spokes.** The first cut was five branches straight off a trunk,
# and it read as a candelabra — because a candelabra is exactly that. What makes
# a staghorn a staghorn is that a branch divides *again*: two of the five carry a
# second fork near their tip, at a wider angle than the first. Two is enough; the
# eye reads the rule from one instance of it and a full recursion would triple
# the triangle count for a shape nobody can resolve at swimming distance.
#
# **The tips are the colour.** Living coral grows at the tips, and the growing
# ends are paler than the trunk almost to white. That gradient is the single
# strongest cue that the thing is alive rather than rock, and it is what
# `coral_dead.wam` removes — nothing else about that model differs. Doing it as
# a material band per segment costs nothing: a sweep's `material=` on a segment
# bands the tube from there on.
#
# **Sweeps, not lofts.** A coral branch is a tube that bends twice on its way up
# — out from the trunk, then back toward vertical — and `sweep`'s bends are
# world-referenced (`up=`/`fwd=`), so neither bend is a sign to guess at. The
# compiler prints the realised path of every one of them, which is how the two
# that used to end up pointing back down at the sand were found.
#
# Branches that lean along X are rooted a half-thickness off the axis in the
# same direction, so each is honestly one-sided; the ones that lean along Z stay
# centred and are symmetric. Those are the only two arrangements the centreline
# lint accepts, and the reason is sound — a part straddling X=0 unevenly is
# claiming a symmetry it does not have. See `sea_grass.wam`, same rule.

model coral_branch
  height 0.80
  style chunky

palette
  Coral #e35c7c
  Rose  #f28aa2
  Tip   #ffc2cf
  Foot  #a8425e

skeleton
  root rock at 0.0
  bone stump parent=rock dir=up pitch=-2 len=0.26

parts
  # The stump. Short, fat and darker than everything on it: a staghorn's base is
  # a crust cemented to the rock, and the height it does not use is height the
  # branches get instead.
  loft base bones=rock..stump material=Foot sides=7
    ring 0.00 w=0.30 d=0.28
    ring 0.22 w=0.22 d=0.21
    ring 0.70 w=0.19 d=0.18 material=Coral
    ring 1.00 w=0.17 d=0.16
    cap start=flat end=flat

  # Five primaries. Each leaves the stump leaning out and bends back toward
  # vertical over its length, which is what gives the colony its vase outline
  # instead of a starburst — and it is why the last segment of every one of
  # these carries `up=`.
  sweep armA bone=stump at=0.55 offset=(-0.10,0,0.02) dir=up tilt=38 material=Coral
    seg len=0.14 r=0.055 up=6
    seg len=0.13 r=0.046 up=20
    seg len=0.12 r=0.036 up=26 material=Rose
    seg len=0.08 r=0.020 up=18 material=Tip tip
  sweep armB bone=stump at=0.80 offset=(0.10,0,-0.03) dir=up tilt=-30 material=Coral
    seg len=0.15 r=0.052 up=8
    seg len=0.14 r=0.043 up=22
    seg len=0.12 r=0.033 up=28 material=Rose
    seg len=0.08 r=0.018 up=16 material=Tip tip
  sweep armC bone=stump at=0.65 offset=(0,0,0.10) dir=up pitch=34 material=Coral
    seg len=0.13 r=0.050 up=6
    seg len=0.13 r=0.041 up=20
    seg len=0.11 r=0.031 up=24 material=Rose
    seg len=0.07 r=0.017 up=16 material=Tip tip
  sweep armD bone=stump at=0.90 offset=(0,0,-0.09) dir=up pitch=-28 material=Coral
    seg len=0.12 r=0.047 up=8
    seg len=0.12 r=0.038 up=22
    seg len=0.10 r=0.028 up=26 material=Rose
    seg len=0.07 r=0.016 up=14 material=Tip tip
  # The leader: shorter lean, so it goes up the middle and is the tallest thing
  # in the colony. Centred on X, so symmetric rather than one-sided.
  sweep armE bone=stump at=1.00 dir=up pitch=10 material=Coral
    seg len=0.16 r=0.058 up=2
    seg len=0.15 r=0.046 up=8
    seg len=0.13 r=0.034 up=10 material=Rose
    seg len=0.09 r=0.019 up=6 material=Tip tip

  # The second fork, on two of the five. Rooted `on=` its parent branch so it is
  # flush by construction rather than by a coordinate I would have had to solve,
  # and thrown out at a wider angle than the primary left the stump at — a fork
  # that opens *less* than its parent reads as a kink in one branch.
  sweep forkA bone=stump at=0.55 offset=(-0.26,0.30,0.04) dir=up tilt=62 on=armA material=Rose
    seg len=0.10 r=0.030 up=18
    seg len=0.09 r=0.022 up=24
    seg len=0.06 r=0.014 up=18 material=Tip tip
  sweep forkE bone=stump at=1.00 offset=(0.05,0.34,0.10) dir=up pitch=54 on=armE material=Rose
    seg len=0.11 r=0.032 up=16
    seg len=0.09 r=0.023 up=22
    seg len=0.06 r=0.014 up=16 material=Tip tip

checks
  # Cemented to the rock, and the stump is the widest thing at the bottom.
  assert bottom(base) < 0.01
  assert width(base) > 0.25
  # A colony, not a candelabra: the leader is tallest, and every primary clears
  # the stump it grows out of by a good margin.
  assert top(armE) > top(armA)
  assert top(armE) > top(armC)
  assert top(armA) > top(base) * 2.0
  # It forks. If this fails the second-order branches have been lost and the
  # model is spokes again.
  assert top(forkA) > top(armA) * 0.85
  assert top(forkE) > top(armE) * 0.85
  # Vase, not starburst: the colony is taller than it is wide. This is the check
  # the trailing `up=` bends on every arm exist to satisfy, and it is also what
  # keeps `BlockModels` (which scales by height alone) from delivering a coral
  # twice as wide as its own cell.
  assert height > width
  assert height > depth
  assert width / height in 0.55..0.95
  assert parts == 8
  assert tris < 900
  measure spread width / height
