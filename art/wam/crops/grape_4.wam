# Grape, ripe (rung 4 of 4 — grape has five stages over four models).
#
# cropdata silhouette: "Vine climbing the full trellis with heavy purple bunches hanging
# beneath the leaves."
#
# ---- why this crop was converted, after greenbean left ---------------------------
#
# `climbVine` in `world/crops.js` is one generated weave — three sine strands with small
# blades on them — and it was shared by all four trellis crops. Green bean took its own vine
# in the third batch, which left grape, hops and snow pea as three species wearing one
# costume, told apart by `colors.fruit` alone. That is the orchard four's fault exactly, one
# style down, and colour cannot fix it: the strands are the same strands.
#
# ---- what makes this a grape and not the other two -------------------------------
#
# A grapevine is the one trellis crop that is not a twining string. It is TRAINED: a thick
# woody bole to about two fifths of the frame, then two horizontal CORDONS running out to the
# posts, and vertical canes rising off them. That candelabra is a rigid, architectural shape
# nothing else on the farm has — hops climbs as a single spiralling bine and snow pea is a
# tangle of thread and tendril, and each of the three asserts the number that keeps it out of
# the other two (see `checks`).
#
# The bunches are the other half, and they are the shape problem the bean pod pair was:
#
#   - HEAVY. A bunch is 21 cm across the shoulders on a 2 m plant and 40 cm long. The old
#     recipe hung eight 10 cm icosahedra in a `cluster: 7` fan, which is `scatterOnto` doing
#     its honest best and still reads as gravel — a bunch is one MASS with a taper, not a
#     count of beads.
#   - TAPERED. Wide at the shoulder, drawn to a point: that taper is the entire difference
#     between a grape bunch and the amethyst the first render produced, and it is asserted.
#   - SCALLOPED. The rings alternate wide and narrow down the loft, so the profile is knobbly
#     rather than a smooth cone. Six berries' worth of read for a hundred triangles.
#   - BENEATH THE LEAVES, which is the silhouette line's own last clause: they hang off the
#     cordon and the lower cane, under the leaf mass the upper canes carry, and `checks`
#     re-asserts the clearance every compile.
#
# The trellis FRAME is still generated by `world/crops.js` (`trellisFrame`) and merged after
# this model — the frame belongs to the STYLE and all four trellis crops share one.
# `ownVine: true` in the recipe is what stops `climbVine` throwing this model away; without
# it a WAM trellis crop compiles, installs, loads, and is then silently discarded.
#
# See `icecapmoss_3.wam` for the material-name and no-`textures` rules.

model grape
  height 2.0
  style chunky

palette
  Wood      #6b4a2c
  Green     #4e8a30
  DarkGreen #3d7026
  Berry     #7a3a8c

skeleton
  root ground at 0.0
  # A GNARLED bole: two bones leaning opposite ways, which is a kink rather than a post. The
  # other two trellis crops have no woody trunk at all.
  bone t1 parent=ground dir=up tilt=7  len=0.22
  bone t2 parent=t1     dir=up tilt=-11 len=0.20

  mirror
    # The cordon: nearly horizontal, reaching the trellis post. `trellisHalfWidth` is
    # TILE_M * 0.34 = 0.355 m, which on a 2.0 m crop is 0.177 of the height — so a 0.175
    # cordon lands on the post it is tied to.
    bone cord parent=t2 dir=side tilt=7 len=0.175
    # Canes rise off the cordon. `tilt` on an `up` bone moves it toward -X, so the negative
    # one splays outward on the left side and the positive one leans back over the middle.
    bone cnA parent=cord at=0.55 dir=up tilt=-6 len=0.40
    bone cnB parent=cord at=0.98 dir=up tilt=8  len=0.34
  end

parts
  # The bole. Thick, and it is one of the three numbers that separate this species from hops
  # and snow pea: 12 cm of trunk at the soil against a bine and a thread.
  loft bole bones=t1..t2 material=Wood sides=6
    ring 0.00 w=0.062 d=0.062
    ring 0.34 w=0.050 d=0.050
    ring 0.70 w=0.047 d=0.047
    ring 1.00 w=0.040 d=0.040
    cap start=flat end=flat

  mirror
    loft arm bones=cord..cord material=Wood sides=5
      ring 0.00 w=0.038 d=0.038
      ring 1.00 w=0.026 d=0.026
      cap start=flat end=dome
    loft caneA bones=cnA..cnA material=Wood sides=5
      ring 0.00 w=0.026 d=0.026
      ring 0.55 w=0.019 d=0.019
      ring 1.00 w=0.013 d=0.013
      cap start=flat end=dome
    loft caneB bones=cnB..cnB material=Wood sides=5
      ring 0.00 w=0.024 d=0.024
      ring 0.55 w=0.017 d=0.017
      ring 1.00 w=0.012 d=0.012
      cap start=flat end=dome
  end

  # ---- the leaves ----------------------------------------------------------------
  #
  # BROAD and BLUNT. A grape leaf is a 30 cm heart with a wide notched end; the bean's is a
  # 24 cm point and the hop's is smaller again. `frame=up` with w wide and d thin is the flat
  # blade lying face-up that `cocoa_4.wam` spells out — get the pairing backwards and the
  # canopy is a set of vertical fins.
  #
  # The tip ring is 0.092 against green bean's 0.043: that blunt end is most of what makes
  # this leaf read as a grape rather than as more bean foliage, and `area` asserts it.
  mirror
    loft lfA1 bone=cnA at=0.30 dir=side yaw=20  tilt=-16 len=0.16 material=Green frame=up sides=5
      ring 0.00 w=0.028 d=0.012
      ring 0.26 w=0.132 d=0.022
      ring 0.66 w=0.150 d=0.020
      ring 1.00 w=0.092 d=0.012
      cap start=flat end=dome
    loft lfA2 bone=cnA at=0.58 dir=side yaw=-64 tilt=-10 len=0.15 material=DarkGreen frame=up sides=5
      ring 0.00 w=0.026 d=0.012
      ring 0.26 w=0.124 d=0.021
      ring 0.66 w=0.142 d=0.019
      ring 1.00 w=0.086 d=0.011
      cap start=flat end=dome
    loft lfA3 bone=cnA at=0.88 dir=side yaw=44  tilt=-6  len=0.15 material=Green frame=up sides=5
      ring 0.00 w=0.026 d=0.012
      ring 0.26 w=0.124 d=0.021
      ring 0.66 w=0.142 d=0.019
      ring 1.00 w=0.086 d=0.011
      cap start=flat end=dome
    loft lfB1 bone=cnB at=0.34 dir=side yaw=-28 tilt=-14 len=0.15 material=DarkGreen frame=up sides=5
      ring 0.00 w=0.026 d=0.012
      ring 0.26 w=0.126 d=0.021
      ring 0.66 w=0.144 d=0.019
      ring 1.00 w=0.088 d=0.011
      cap start=flat end=dome
    loft lfB2 bone=cnB at=0.66 dir=side yaw=72  tilt=-8  len=0.14 material=Green frame=up sides=5
      ring 0.00 w=0.024 d=0.011
      ring 0.26 w=0.118 d=0.020
      ring 0.66 w=0.136 d=0.018
      ring 1.00 w=0.082 d=0.011
      cap start=flat end=dome
    loft lfB3 bone=cnB at=0.94 dir=side yaw=-52 tilt=-4  len=0.14 material=DarkGreen frame=up sides=5
      ring 0.00 w=0.024 d=0.011
      ring 0.26 w=0.118 d=0.020
      ring 0.66 w=0.136 d=0.018
      ring 1.00 w=0.082 d=0.011
      cap start=flat end=dome
    # The first render of this rung had six leaves per side, all at tilt -4 to -16, and they
    # stacked into horizontal SHELVES — the canopy read as a conifer's tiers with a purple
    # crop hanging under it. These five are steeper (-22 to -34) and turned across the first
    # six, which is what turns a stack of discs into a leaf mass with a plant inside it.
    loft lfA4 bone=cnA at=0.99 dir=side yaw=-12 tilt=-30 len=0.15 material=DarkGreen frame=up sides=5
      ring 0.00 w=0.026 d=0.012
      ring 0.26 w=0.124 d=0.021
      ring 0.66 w=0.142 d=0.019
      ring 1.00 w=0.086 d=0.011
      cap start=flat end=dome
    loft lfA5 bone=cnA at=0.44 dir=side yaw=132 tilt=-26 len=0.15 material=Green frame=up sides=5
      ring 0.00 w=0.026 d=0.012
      ring 0.26 w=0.124 d=0.021
      ring 0.66 w=0.142 d=0.019
      ring 1.00 w=0.086 d=0.011
      cap start=flat end=dome
    loft lfA6 bone=cnA at=0.74 dir=side yaw=-140 tilt=-22 len=0.14 material=DarkGreen frame=up sides=5
      ring 0.00 w=0.024 d=0.011
      ring 0.26 w=0.118 d=0.020
      ring 0.66 w=0.136 d=0.018
      ring 1.00 w=0.082 d=0.011
      cap start=flat end=dome
    loft lfB4 bone=cnB at=0.20 dir=side yaw=118 tilt=-24 len=0.15 material=Green frame=up sides=5
      ring 0.00 w=0.026 d=0.012
      ring 0.26 w=0.124 d=0.021
      ring 0.66 w=0.142 d=0.019
      ring 1.00 w=0.086 d=0.011
      cap start=flat end=dome
    loft lfB5 bone=cnB at=0.50 dir=side yaw=-152 tilt=-34 len=0.14 material=DarkGreen frame=up sides=5
      ring 0.00 w=0.024 d=0.011
      ring 0.26 w=0.118 d=0.020
      ring 0.66 w=0.136 d=0.018
      ring 1.00 w=0.082 d=0.011
      cap start=flat end=dome
  end

  # ---- the bunches ---------------------------------------------------------------
  #
  # One loft each, hanging straight down off the woodwork. The ring list alternates wide and
  # narrow so the profile is knobbly — that scallop is what says "many berries" without
  # paying for many berries — and the whole thing narrows from a 0.105 shoulder to a point,
  # which is the taper the checks police.
  mirror
    loft bnA bone=cord at=0.34 offset=(0,-0.018,0.030) dir=down pitch=6 len=0.20 material=Berry sides=6
      ring 0.00 w=0.048 d=0.046
      ring 0.10 w=0.105 d=0.100
      ring 0.24 w=0.088 d=0.084
      ring 0.40 w=0.100 d=0.096
      ring 0.56 w=0.068 d=0.065
      ring 0.72 w=0.066 d=0.063
      ring 0.86 w=0.040 d=0.038
      ring 1.00 w=0.022 d=0.021 tip
      cap start=dome end=point
    loft bnB bone=cord at=0.80 offset=(0,-0.018,-0.034) dir=down pitch=-5 len=0.18 material=Berry sides=6
      ring 0.00 w=0.044 d=0.042
      ring 0.10 w=0.098 d=0.094
      ring 0.24 w=0.082 d=0.078
      ring 0.40 w=0.093 d=0.089
      ring 0.56 w=0.063 d=0.060
      ring 0.72 w=0.061 d=0.058
      ring 0.86 w=0.037 d=0.035
      ring 1.00 w=0.020 d=0.019 tip
      cap start=dome end=point
    loft bnC bone=cnA at=0.26 offset=(0.030,-0.016,0.028) dir=down pitch=7 len=0.17 material=Berry sides=6
      ring 0.00 w=0.042 d=0.040
      ring 0.10 w=0.094 d=0.090
      ring 0.24 w=0.078 d=0.075
      ring 0.40 w=0.089 d=0.085
      ring 0.56 w=0.060 d=0.057
      ring 0.72 w=0.058 d=0.055
      ring 0.86 w=0.035 d=0.033
      ring 1.00 w=0.019 d=0.018 tip
      cap start=dome end=point
  end

checks
  assert bottom(bole) < 0.02
  # ---- the three numbers that keep grape, hops and snow pea apart ----------------
  #
  # 1. A WOODY BOLE. Hops asserts its bine under 0.030 and snow pea its thread under 0.020,
  #    so no two of the three can drift into one costume without a compile failing.
  assert width(bole) > 0.052
  assert height(bole) / height in 0.40..0.56
  # 2. A HORIZONTAL CORDON — the trained candelabra. Neither of the other two has a limb
  #    within 40 degrees of the ground plane.
  assert elevation(cord.l) < 20
  assert xmax(arm.l) > 0.15
  # 3. BROAD leaves. Hops asserts area < 0.020 and snow pea < 0.012 on the same measure.
  assert area(lfA1.l) > 0.030
  # 4. And the whole plant is the WIDEST of the three: a trained vine spreads along its
  #    cordons where hops climbs a string (asserted under 0.42) and snow pea threads
  #    (0.42..0.55).
  assert width / height in 0.62..0.85
  # ---- "heavy bunches hanging beneath the leaves" --------------------------------
  #
  # HEAVY: a bunch is wider than any hop cone or pea pod on the farm, by a factor of three.
  assert width(bnA.l) > 0.085
  # TAPERED, and this is the amethyst test. Ring widths are not addressable from here, so the
  # taper is measured as fill: a straight tube fills 0.79 of its own bounding box, a cone
  # fills 0.26. Anything under 0.45 has a real shoulder-to-point taper in it.
  assert volume(bnA.l) / (width(bnA.l) * width(bnA.l) * height(bnA.l)) < 0.45
  assert height(bnA.l) / width(bnA.l) in 1.5..2.6
  # BENEATH: every bunch top clears the lowest leaf that hangs over it.
  assert top(bnA.l) < bottom(lfA1.l) - 0.05
  assert top(bnC.l) < bottom(lfA2.l) - 0.02
  # Inside the frame `world/crops.js` merges around it: the posts are at 0.177 of the height.
  assert xmax(caneA.l) < 0.20
  # The bole LEANS on purpose — two bones tilted opposite ways is the gnarl — so this is a
  # ceiling on the kink, not a symmetry claim.
  assert asymmetry(bole) < 0.09
  # Budget: footprint 1, so `TRI_BUDGET` = 2600 before the decimator steps in.
  assert tris < 2300
  measure bunch height(bnA.l) / width(bnA.l)
