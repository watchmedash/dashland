# Stonecrop, ripe (rung 4 of 4).
#
# cropdata silhouette: "Fleshy grey-green rosettes wedged into bare rock, topped with a
# flat yellow flower cluster." The recipe it replaces shared agave's ladder — `Cactus_1`
# then `Plant_1` three times, `world/crops.js`'s generated `rosette`, plus four flat
# generated discs for the flowers. Photographed at the audit site it is 172 triangles of
# pale spider-legs on the grass, and the flower discs are not distinguishable from the
# leaves at all.
#
# Three things this fixes, and each is the difference between a succulent and a tuft:
#
#   - FLESHY. Every leaf is a fat rounded spoon, `d` roughly two-thirds of `w`, ending in
#     a DOME rather than a point. A spike is an agave; a spoon is a sedum. The old
#     generated rosette had one blade profile shared with agave and the spike flag as the
#     only difference between them, so the two crops were the same plant in two colours.
#   - ROSETTES, PLURAL. cropdata says rosettes and the model carries three — one central
#     and a mirrored pair of smaller ones — so `clump` can drop from 3 to 2 and still fill
#     a tile with something that reads as a colony rather than as three identical stamps.
#   - The flower cluster is FLAT and ON TOP: a corymb, one plate of florets held just
#     above the crown on short stalks. Not scattered over the plant, which is what a
#     `zone: 'canopy'` scatter does and what the audit called speckle.
#
# See `icecapmoss_3.wam` for the material-name and no-`textures` rules.

model stonecrop
  height 0.30
  style smooth

palette
  Wood      #7a8a6a
  Green     #9ab08a
  DarkGreen #7f9673
  Berry     #e0c46a

skeleton
  root rock at 0.0
  bone core parent=rock dir=up len=0.16

  # The central rosette: five mirrored pairs, outer lying back, inner standing up.
  mirror
    bone lfA parent=core dir=side tilt=14 len=0.44
    bone lfB parent=core dir=side yaw=48  tilt=26 len=0.41
    bone lfC parent=core dir=side yaw=100 tilt=20 len=0.43
    bone lfD parent=core dir=side yaw=146 tilt=40 len=0.36
    bone lfE parent=core dir=side yaw=24  tilt=58 len=0.30
  end

  # The satellites. A `mirror` block reflects the offset too, so one pair of bones gives
  # two whole rosettes standing away from the middle — which is exactly the colony the
  # silhouette line asks for and is a thing `clump` cannot express, because `clump` stamps
  # the SAME model N times and would give three identical plants in a ring.
  mirror
    bone satL parent=rock offset=(0.32,0,0.50) dir=up len=0.10
    bone sfA parent=satL dir=side tilt=18 len=0.30
    bone sfB parent=satL dir=side yaw=72  tilt=30 len=0.27
    bone sfC parent=satL dir=side yaw=144 tilt=24 len=0.28
    bone sfD parent=satL dir=side yaw=216 tilt=46 len=0.23
  end

  # The flower stalks. SHORT: cropdata says the cluster tops the rosette, and a corymb on
  # a tall stem is a different plant entirely.
  bone stalk parent=core dir=up pitch=-3 len=0.30

parts
  loft crown bones=rock..core material=Wood sides=8
    ring 0.00 w=0.26 d=0.26
    ring 1.00 w=0.20 d=0.20
    cap start=flat end=flat
  mirror
    loft satcrown bones=satL..satL material=Wood sides=6
      ring 0.00 w=0.18 d=0.18
      ring 1.00 w=0.14 d=0.14
      cap start=flat end=flat
  end

  # FLESHY SPOONS. Widest and thickest two-thirds of the way out, rounded at the end. The
  # `d`-to-`w` ratio is the whole species read against agave, which is the same
  # construction with `d` at half of `w` and a `tip` on the last ring.
  mirror
    loft leafA bones=lfA..lfA material=Green frame=up sides=6
      ring 0.00 w=0.115 d=0.080
      ring 0.42 w=0.185 d=0.130
      ring 0.80 w=0.190 d=0.132
      ring 1.00 w=0.110 d=0.078
      cap start=dome end=dome
    loft leafB bones=lfB..lfB material=DarkGreen frame=up sides=6
      ring 0.00 w=0.108 d=0.076
      ring 0.42 w=0.175 d=0.122
      ring 0.80 w=0.180 d=0.125
      ring 1.00 w=0.104 d=0.074
      cap start=dome end=dome
    loft leafC bones=lfC..lfC material=Green frame=up sides=6
      ring 0.00 w=0.112 d=0.078
      ring 0.42 w=0.180 d=0.126
      ring 0.80 w=0.185 d=0.129
      ring 1.00 w=0.107 d=0.076
      cap start=dome end=dome
    loft leafD bones=lfD..lfD material=DarkGreen frame=up sides=6
      ring 0.00 w=0.100 d=0.070
      ring 0.42 w=0.162 d=0.113
      ring 0.80 w=0.166 d=0.116
      ring 1.00 w=0.096 d=0.068
      cap start=dome end=dome
    loft leafE bones=lfE..lfE material=Green frame=up sides=6
      ring 0.00 w=0.092 d=0.064
      ring 0.42 w=0.148 d=0.104
      ring 0.80 w=0.152 d=0.106
      ring 1.00 w=0.088 d=0.062
      cap start=dome end=dome
  end

  mirror
    loft sleafA bones=sfA..sfA material=DarkGreen frame=up sides=5
      ring 0.00 w=0.086 d=0.060
      ring 0.42 w=0.138 d=0.097
      ring 0.80 w=0.142 d=0.099
      ring 1.00 w=0.082 d=0.058
      cap start=dome end=dome
    loft sleafB bones=sfB..sfB material=Green frame=up sides=5
      ring 0.00 w=0.080 d=0.056
      ring 0.42 w=0.128 d=0.090
      ring 0.80 w=0.132 d=0.092
      ring 1.00 w=0.076 d=0.054
      cap start=dome end=dome
    loft sleafC bones=sfC..sfC material=DarkGreen frame=up sides=5
      ring 0.00 w=0.082 d=0.058
      ring 0.42 w=0.132 d=0.092
      ring 0.80 w=0.136 d=0.095
      ring 1.00 w=0.078 d=0.055
      cap start=dome end=dome
    loft sleafD bones=sfD..sfD material=Green frame=up sides=5
      ring 0.00 w=0.072 d=0.050
      ring 0.42 w=0.116 d=0.081
      ring 0.80 w=0.120 d=0.084
      ring 1.00 w=0.068 d=0.048
      cap start=dome end=dome
  end

  loft peduncle bones=core..stalk material=Wood sides=5
    ring 0.00 w=0.055 d=0.055
    ring 1.00 w=0.040 d=0.040
    cap start=flat end=flat

  # THE CORYMB. A flat plate of florets, held on stalks that all reach the SAME height —
  # which is what makes a corymb flat-topped and is the shape word in cropdata's line.
  # One central floret plus a mirrored pair at each of two bearings gives five heads on a
  # disc about two-thirds of the rosette's own span.
  loft florC bone=stalk at=1.00 dir=up len=0.055 material=Berry sides=8
    ring 0.00 w=0.11 d=0.11
    ring 0.55 w=0.17 d=0.17
    ring 1.00 w=0.12 d=0.12
    cap start=flat end=flat
  mirror
    loft florA bone=stalk at=1.00 offset=(0.17,0,0.05) dir=up len=0.050 material=Berry sides=7
      ring 0.00 w=0.10 d=0.10
      ring 0.55 w=0.155 d=0.155
      ring 1.00 w=0.11 d=0.11
      cap start=flat end=flat
    loft florB bone=stalk at=1.00 offset=(0.07,0,-0.18) dir=up len=0.048 material=Berry sides=7
      ring 0.00 w=0.095 d=0.095
      ring 0.55 w=0.148 d=0.148
      ring 1.00 w=0.105 d=0.105
      cap start=flat end=flat
  end

checks
  # FLESHY, not spiky. This is the number that separates stonecrop from agave, which is
  # built the same way with `d` at half of `w` and a spine on the end.
  assert depth(leafA.l) / height(leafA.l) > 0.55
  # ...and blunt: the last ring is most of the widest one, so the leaf ends in a spoon.
  assert width(leafA.l) > 0.30
  # THE CLUSTER IS FLAT AND ON TOP. Flat: much wider than it is deep. On top: above every
  # leaf in the rosette, which the scattered version never was.
  assert width(florC) / height(florC) > 2.0
  assert bottom(florC) > top(leafE.l)
  assert top(florA.l) == top(florC) +- 0.02
  # Rosettes, plural: the satellites stand clear of the central one.
  assert xmax(satcrown.l) > xmax(crown)
  assert top(sleafA.l) < top(leafE.l)
  # A rosette has a middle.
  assert top(leafE.l) > top(leafA.l) + 0.03
  assert bottom(crown) < 0.02
  assert asymmetry(crown) < 0.005
  # Low and spreading, but not so wide that `familyScale` binds on WIDTH and delivers a
  # 20 cm plant where cropdata asked for 30. A 0.30 m crop on a 1.04 m tile allows about
  # 2.4 at the default width cap; `wide: 1.15` on the recipe takes that to 2.9, which is
  # the margin a three-rosette colony needs. The first cut put the satellites at x = 0.62
  # and measured 3.58, i.e. it would have arrived at two thirds of its stated height.
  assert width / height in 1.6..2.6
  # Budget: `clump: 2`.
  assert tris < 1300
  measure aspect width / height
  measure fleshy depth(leafA.l) / height(leafA.l)
