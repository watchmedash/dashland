# Raw silver — ore still in its host rock.
#
# Silver's vein is nearly the value of the rock, so it is the *lightest* thing
# in the model by a clear margin and the stone goes dark to buy that contrast.
# A pale vein on pale stone was a lump with a smudge on it.
#
# This used to be built the other way round — `material=Stone` with the metal
# as two narrow `material_arc` veins — on the reasoning that a *raw* ore is
# mostly its host rock. Measured in the hotbar that came out at 10-16% metal by
# pixel, and the four raw ores landed within ten counts of each other on every
# channel (copper 71,57,49, iron 76,67,58, gold 76,69,54, silver 69,68,66) —
# one item in four colours nobody can tell apart at 46px, while the four ingots
# beside them are unmistakable.
#
# So the materials are swapped. The metal is the loft's own material and the
# rock is what is banded onto it, which keeps every good thing about the old
# construction — a vein is still a stripe *around* the tube, still one loft,
# still no shiny warts stuck on the outside — and only changes which of the two
# is the ground and which is the figure. An ore lump you have just prised out of
# a wall is a lump OF the metal with rock still clinging to it, so this is also
# the truer picture, and it is the one that survives being 46 pixels wide.
#
# The stone is one contiguous 90-degree face rather than being spread evenly,
# because a rock patch you can see all the way round reads as dirt on the metal;
# a rock patch with an edge to it reads as the matrix the lump broke out of.
#
# Held next to `raw_gold`, only the vein colour differs. That is deliberate:
# they come out of the same rock, and the smelted ingots are where the two
# metals get different silhouettes.

model raw_silver
  height 0.3
  style chunky

palette
  Stone #5e5b58
  Vein  #d4dae2

skeleton
  root base at 0.0
  bone lump parent=base dir=up pitch=-6 len=0.58

parts
  # `sides=8` is set by the material boundary, not by the silhouette: an arc
  # snaps to the ring's own vertices, so the coarsest the mesh can cut is one
  # segment — 60° at six sides, which cannot land a rock face on a lump this
  # small without eating half of it. Eight sides puts the seam every 45°, and
  # holding the rolls close together keeps the rock face running straight down
  # the lump instead of spiralling round it.
  loft ore bones=base..lump material=Vein sides=8 shape=squarish
    ring 0.00 w=0.36 d=0.32 roll=6 material_arc=Stone:135-225
    ring 0.26 w=0.60 d=0.50 roll=10 fwd=0.03 material_arc=Stone:135-225
    ring 0.60 w=0.62 d=0.52 roll=4 side=-0.03 material_arc=Stone:135-225
    ring 0.86 w=0.42 d=0.34 roll=8 fwd=-0.03 material_arc=Stone:135-225
    ring 1.00 w=0.18 d=0.16 roll=6
    cap start=flat end=flat

  # A knuckle on the shoulder — the step in the outline that stops a lump from
  # reading as a ball at hotbar size.
  loft knuckle bone=lump at=0.46 offset=(-0.20,0,0.10) dir=side yaw=150 tilt=18 len=0.20 on=ore material=Stone sides=5 shape=squarish
    ring 0.00 w=0.26 d=0.24
    ring 0.55 w=0.28 d=0.25 roll=20
    ring 1.00 w=0.13 d=0.12 roll=-8
    cap start=flat end=flat

checks
  assert bottom(ore) < 0.01
  assert height / width in 0.6..1.2
  assert parts == 2
  assert tris < 260
