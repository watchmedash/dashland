# Green Bean, ripe (rung 4 of 4).
#
# cropdata silhouette: "Twining vine with long straight pods hanging in pairs."
#
# ---- what two rounds of fixing already bought, and what was left ----------------
#
# This crop has been through the audit twice. The first round found "no visible produce at
# all" and the cause was colour: `colors.fruit` was 0x8fce4a against a `colors.leaf` of
# 0x6cc94a, two greens four percent apart, so a pod on the vine was a leaf. cropdata deepened
# the pod to 0x2f7d16 and that is fixed and stays fixed. The second round found "pods visible
# but not distinctive", and that one is SHAPE: `scatterOnto` places a stretched icosahedron,
# and a stretched icosahedron is a bean-shaped blob. Swapping in `produce/bean01` made it a
# modelled pod and left the two things the silhouette line actually asks for untouched —
#
#   - LONG and STRAIGHT. A pod here is nine times as long as it is wide and dead straight,
#     which is a silhouette no scatter can produce because a scatter has no axis to align to.
#   - IN PAIRS. Beans hang two to a node, and a pair is a shape rather than a density: two
#     parallel lines a pod's width apart read as beans where six singles read as speckle.
#
# ...and one thing nothing had ever supplied: the vine does not TWINE. `climbVine` in
# `world/crops.js` weaves three strands across the frame and is a real improvement on the
# bamboo cane it replaced, but it is one generated shape shared by all four trellis crops, so
# grape, hops, snow pea and this are the same plant in four fruit colours. The stem here is a
# five-bone chain whose segments alternate their lean, which is a zig-zag climb — and the
# pods hang off its OUTSIDE, clear of the leaves, where the frame's own uprights frame them.
#
# The trellis itself is still generated by `world/crops.js` (`trellisFrame`) and merged after
# this model, which is correct: the frame belongs to the STYLE, not to the species, and all
# four trellis crops must share one. `ownVine: true` in the recipe is what stops `climbVine`
# throwing this model away — without it a WAM trellis crop compiles, installs, loads, and is
# then silently discarded.
#
# See `icecapmoss_3.wam` for the material-name and no-`textures` rules.

model greenbean
  height 1.8
  style chunky

palette
  Wood      #4f8f33
  Green     #6cc94a
  DarkGreen #4e9c35
  Berry     #2f7d16

skeleton
  root ground at 0.0
  # Two stems, weaving in opposite phase. `tilt` on an `up` bone moves it toward -X, so the
  # alternating sign is the zig-zag; the amplitude is kept inside 0.20 of the model's height,
  # which is exactly `trellisHalfWidth` for a footprint-1 crop (TILE_M * 0.34 / 1.8).
  mirror
    bone c1 parent=ground offset=(0.02,0,0.015) dir=up tilt=-36 len=0.23
    bone c2 parent=c1 dir=up tilt=44  len=0.23
    bone c3 parent=c2 dir=up tilt=-42 len=0.22
    bone c4 parent=c3 dir=up tilt=40  len=0.21
    bone c5 parent=c4 dir=up tilt=-30 len=0.19
  end

parts
  mirror
    # One loft along the whole chain, so the stem is continuous through every kink. Thin —
    # a bean vine is a string, and a fat one reads as a sapling.
    loft vine bones=c1..c5 material=Wood sides=5
      ring 0.00 w=0.030 d=0.030
      ring 0.50 w=0.022 d=0.022
      ring 1.00 w=0.014 d=0.014
      cap start=flat end=dome
  end

  # ---- the leaves ----------------------------------------------------------------
  #
  # Trifoliate, which is what a bean leaf is: three broad blades off one node. `frame=up`
  # with w WIDE and d THIN — a flat blade lying face-up, the idiom `cocoa_4.wam` spells out.
  # Kept SMALL on purpose: `world/crops.js` records that at 0.17 of a 1.8 m plant these
  # became 30 cm arrowheads and buried the pods completely, and burying the pods is the bug.
  mirror
    loft lfA1 bone=c1 at=0.90 dir=side yaw=10  tilt=-14 len=0.17 material=Green frame=up sides=5
      ring 0.00 w=0.020 d=0.010
      ring 0.30 w=0.115 d=0.020
      ring 0.74 w=0.120 d=0.018
      ring 1.00 w=0.048 d=0.010
      cap start=flat end=dome
    loft lfA2 bone=c1 at=0.90 dir=side yaw=76  tilt=-8  len=0.15 material=DarkGreen frame=up sides=5
      ring 0.00 w=0.018 d=0.010
      ring 0.30 w=0.104 d=0.019
      ring 0.74 w=0.108 d=0.017
      ring 1.00 w=0.043 d=0.009
      cap start=flat end=dome
    loft lfB1 bone=c2 at=0.85 dir=side yaw=-38 tilt=-12 len=0.17 material=DarkGreen frame=up sides=5
      ring 0.00 w=0.020 d=0.010
      ring 0.30 w=0.115 d=0.020
      ring 0.74 w=0.120 d=0.018
      ring 1.00 w=0.048 d=0.010
      cap start=flat end=dome
    loft lfB2 bone=c2 at=0.85 dir=side yaw=-104 tilt=-6 len=0.14 material=Green frame=up sides=5
      ring 0.00 w=0.018 d=0.009
      ring 0.30 w=0.100 d=0.018
      ring 0.74 w=0.104 d=0.016
      ring 1.00 w=0.041 d=0.009
      cap start=flat end=dome
    loft lfC1 bone=c3 at=0.88 dir=side yaw=22  tilt=-10 len=0.16 material=Green frame=up sides=5
      ring 0.00 w=0.019 d=0.010
      ring 0.30 w=0.110 d=0.019
      ring 0.74 w=0.114 d=0.017
      ring 1.00 w=0.046 d=0.010
      cap start=flat end=dome
    loft lfC2 bone=c3 at=0.88 dir=side yaw=88  tilt=-4  len=0.14 material=DarkGreen frame=up sides=5
      ring 0.00 w=0.018 d=0.009
      ring 0.30 w=0.100 d=0.018
      ring 0.74 w=0.104 d=0.016
      ring 1.00 w=0.041 d=0.009
      cap start=flat end=dome
    loft lfD1 bone=c4 at=0.86 dir=side yaw=-30 tilt=-12 len=0.16 material=DarkGreen frame=up sides=5
      ring 0.00 w=0.019 d=0.010
      ring 0.30 w=0.110 d=0.019
      ring 0.74 w=0.114 d=0.017
      ring 1.00 w=0.046 d=0.010
      cap start=flat end=dome
    loft lfE1 bone=c5 at=0.80 dir=side yaw=34  tilt=-8  len=0.15 material=Green frame=up sides=5
      ring 0.00 w=0.018 d=0.010
      ring 0.30 w=0.105 d=0.019
      ring 0.74 w=0.109 d=0.017
      ring 1.00 w=0.044 d=0.010
      cap start=flat end=dome
    loft lfA3 bone=c1 at=0.45 dir=side yaw=-52 tilt=-10 len=0.15 material=Green frame=up sides=5
      ring 0.00 w=0.018 d=0.010
      ring 0.30 w=0.104 d=0.019
      ring 0.74 w=0.108 d=0.017
      ring 1.00 w=0.043 d=0.009
      cap start=flat end=dome
    loft lfB3 bone=c2 at=0.42 dir=side yaw=64 tilt=-8 len=0.15 material=Green frame=up sides=5
      ring 0.00 w=0.018 d=0.010
      ring 0.30 w=0.104 d=0.019
      ring 0.74 w=0.108 d=0.017
      ring 1.00 w=0.043 d=0.009
      cap start=flat end=dome
    loft lfC3 bone=c3 at=0.4 dir=side yaw=-70 tilt=-12 len=0.14 material=Green frame=up sides=5
      ring 0.00 w=0.018 d=0.010
      ring 0.30 w=0.104 d=0.019
      ring 0.74 w=0.108 d=0.017
      ring 1.00 w=0.043 d=0.009
      cap start=flat end=dome
    loft lfD2 bone=c4 at=0.42 dir=side yaw=54 tilt=-6 len=0.14 material=DarkGreen frame=up sides=5
      ring 0.00 w=0.018 d=0.010
      ring 0.30 w=0.104 d=0.019
      ring 0.74 w=0.108 d=0.017
      ring 1.00 w=0.043 d=0.009
      cap start=flat end=dome
    loft lfD3 bone=c4 at=0.86 dir=side yaw=-96 tilt=-4 len=0.13 material=Green frame=up sides=5
      ring 0.00 w=0.018 d=0.010
      ring 0.30 w=0.104 d=0.019
      ring 0.74 w=0.108 d=0.017
      ring 1.00 w=0.043 d=0.009
      cap start=flat end=dome
    loft lfE2 bone=c5 at=0.8 dir=side yaw=-40 tilt=-10 len=0.13 material=DarkGreen frame=up sides=5
      ring 0.00 w=0.018 d=0.010
      ring 0.30 w=0.104 d=0.019
      ring 0.74 w=0.108 d=0.017
      ring 1.00 w=0.043 d=0.009
      cap start=flat end=dome
  end

  # ---- the pods, in pairs --------------------------------------------------------
  #
  # 0.17 of 1.8 m is a 31 cm bean. That is roughly life size for a runner bean and it is the
  # first time this crop has had one: `r: 0.045` of the plant's height was an 8 cm blob.
  # Nearly parallel-sided over the middle two thirds — a pod that tapers from the top is a
  # chilli — and the two of a pair are half a pod's width apart, hung on the OUTSIDE of the
  # zig-zag where the vine leans away from its own foliage.
  mirror
    loft pdA1 bone=c2 at=0.30 offset=(0.050,-0.020,0.020) dir=down pitch=8 len=0.21 material=Berry sides=5
      ring 0.00 w=0.020 d=0.020
      ring 0.14 w=0.036 d=0.032
      ring 0.80 w=0.034 d=0.030
      ring 1.00 w=0.014 d=0.013 tip
      cap start=dome end=point
    loft pdA2 bone=c2 at=0.30 offset=(0.080,-0.030,0.008) dir=down pitch=-4 len=0.19 material=Berry sides=5
      ring 0.00 w=0.019 d=0.019
      ring 0.14 w=0.034 d=0.030
      ring 0.80 w=0.032 d=0.028
      ring 1.00 w=0.013 d=0.012 tip
      cap start=dome end=point
    loft pdB1 bone=c2 at=0.94 offset=(0.050,-0.020,0.020) dir=down pitch=6 len=0.20 material=Berry sides=5
      ring 0.00 w=0.020 d=0.020
      ring 0.14 w=0.037 d=0.033
      ring 0.80 w=0.035 d=0.031
      ring 1.00 w=0.014 d=0.013 tip
      cap start=dome end=point
    loft pdB2 bone=c2 at=0.94 offset=(0.080,-0.032,0.006) dir=down pitch=-6 len=0.18 material=Berry sides=5
      ring 0.00 w=0.019 d=0.019
      ring 0.14 w=0.035 d=0.031
      ring 0.80 w=0.033 d=0.029
      ring 1.00 w=0.013 d=0.012 tip
      cap start=dome end=point
    loft pdC1 bone=c3 at=0.96 offset=(0.048,-0.020,-0.020) dir=down pitch=8 len=0.18 material=Berry sides=5
      ring 0.00 w=0.019 d=0.019
      ring 0.14 w=0.035 d=0.031
      ring 0.80 w=0.033 d=0.029
      ring 1.00 w=0.013 d=0.012 tip
      cap start=dome end=point
    loft pdC2 bone=c3 at=0.96 offset=(0.078,-0.030,-0.006) dir=down pitch=-4 len=0.16 material=Berry sides=5
      ring 0.00 w=0.018 d=0.018
      ring 0.14 w=0.033 d=0.029
      ring 0.80 w=0.031 d=0.027
      ring 1.00 w=0.012 d=0.011 tip
      cap start=dome end=point
    loft pdD1 bone=c4 at=0.92 offset=(0.046,-0.020,-0.020) dir=down pitch=6 len=0.17 material=Berry sides=5
      ring 0.00 w=0.019 d=0.019
      ring 0.14 w=0.034 d=0.030
      ring 0.80 w=0.032 d=0.028
      ring 1.00 w=0.013 d=0.012 tip
      cap start=dome end=point
    loft pdD2 bone=c4 at=0.92 offset=(0.076,-0.030,-0.006) dir=down pitch=-6 len=0.15 material=Berry sides=5
      ring 0.00 w=0.018 d=0.018
      ring 0.14 w=0.032 d=0.028
      ring 0.80 w=0.030 d=0.026
      ring 1.00 w=0.012 d=0.011 tip
      cap start=dome end=point
  end

checks
  assert bottom(vine.l) < 0.02
  # TWINING: the stem's lateral swing is a real fraction of its height, i.e. it is not a cane.
  assert (xmax(vine.l) - xmin(vine.l)) / height > 0.20
  # ...and it stays inside the trellis `world/crops.js` will merge around it: the frame's
  # half-width is TILE_M * 0.34 = 0.355 m, which on a 1.8 m crop is 0.197 of the height.
  assert xmax(vine.l) < 0.22
  # LONG and STRAIGHT: a pod is at least six times as long as it is wide.
  assert height(pdA1.l) / width(pdA1.l) > 6.0
  assert height(pdA1.l) > 0.14
  # IN PAIRS: the two of a pair are close together and hang at nearly the same height.
  assert dist(pdA1, pdA2) < 0.09
  # ...and CLEAR of the leaves — the pod's tip is well below the blade above it, which is the
  # half of "pods visible but not distinctive" that colour could not fix.
  assert bottom(pdA1.l) < bottom(lfA1.l) - 0.10
  assert width / height < 0.80
  assert asymmetry(vine.l) < 0.9
  # Budget: footprint 1, so `TRI_BUDGET` = 2600 before the decimator steps in.
  assert tris < 2300
  measure podlen height(pdA1.l) / height
