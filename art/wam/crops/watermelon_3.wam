# Watermelon, flowering (rung 3 of 4).
#
# The sprawl of `watermelon_4.wam` at four fifths the size, with a small yellow FLOWER where
# the melon will be. Watermelon has four crop stages over four models, so this rung is stage
# 3 alone and the fruiting one stage 4 alone.
#
# The flower is `Berry`, and here that name carries a yellow rather than the ripe rung's pale
# rind green — a watermelon blossom is a small five-petalled yellow thing, and the whole
# point of spending a rung on it is that the ripeness read becomes a change of SHAPE AND
# COLOUR at once: a small yellow trumpet becomes a big striped barrel. A generated-fruit
# ripeness trick that only halves a count and drags a colour toward the leaf cannot express
# that, which is the argument `squash_3.wam` makes and it applies unchanged here.
#
# The trumpet is smaller than the squash's — mouth 0.19 against 0.26. A squash blossom is
# famously enormous and a watermelon's is not, and since these two crops will stand in
# adjacent beds the difference is worth the two digits it costs.
#
# See `watermelon_4.wam` for the melon and `icecapmoss_3.wam` for the naming rules.

model watermelon
  height 0.62
  style chunky

palette
  Wood      #4a7a2e
  Green     #5f9e3a
  DarkGreen #44762b
  Berry     #e8c93f

skeleton
  root crown at 0.024
  mirror
    bone ptA parent=crown dir=side yaw=18  tilt=34 len=0.188
    bone ptB parent=crown dir=side yaw=72  tilt=26 len=0.216
    bone ptC parent=crown dir=side yaw=-34 tilt=40 len=0.173
    bone ptD parent=crown dir=side yaw=-86 tilt=22 len=0.202
  end

  bone hub parent=crown dir=up len=0.049

  # The flower stalk. One, off-axis, not mirrored — the melon that replaces it is one melon.
  bone fl parent=crown offset=(-0.13,0.02,0.17) dir=up pitch=30 len=0.095

parts
  loft mound bones=crown..hub material=Wood sides=6
    ring 0.00 w=0.11 d=0.11
    ring 1.00 w=0.055 d=0.055
    cap start=dome end=dome
  mirror
    loft stalkA bones=ptA..ptA material=Wood sides=5
      ring 0.00 w=0.050 d=0.050
      ring 1.00 w=0.033 d=0.033
      cap start=dome end=flat
  end

  mirror
    loft stalkB bones=ptB..ptB material=Wood sides=5
      ring 0.00 w=0.048 d=0.048
      ring 1.00 w=0.032 d=0.032
      cap start=dome end=flat
    loft stalkC bones=ptC..ptC material=Wood sides=5
      ring 0.00 w=0.046 d=0.046
      ring 1.00 w=0.030 d=0.030
      cap start=dome end=flat
    loft stalkD bones=ptD..ptD material=Wood sides=5
      ring 0.00 w=0.044 d=0.044
      ring 1.00 w=0.029 d=0.029
      cap start=dome end=flat
  end

  mirror
    loft lfA bone=ptA at=1.00 dir=side yaw=18 tilt=-16 len=0.289 material=Green frame=up sides=6
      ring 0.00 w=0.09 d=0.028
      ring 0.20 w=0.42 d=0.050
      ring 0.38 w=0.22 d=0.040
      ring 0.58 w=0.46 d=0.050
      ring 0.78 w=0.24 d=0.040
      ring 1.00 w=0.16 d=0.024
      cap start=flat end=dome
    loft lfB bone=ptB at=1.00 dir=side yaw=72 tilt=-10 len=0.317 material=DarkGreen frame=up sides=6
      ring 0.00 w=0.09 d=0.028
      ring 0.20 w=0.45 d=0.052
      ring 0.38 w=0.23 d=0.042
      ring 0.58 w=0.49 d=0.052
      ring 0.78 w=0.25 d=0.041
      ring 1.00 w=0.17 d=0.025
      cap start=flat end=dome
    loft lfC bone=ptC at=1.00 dir=side yaw=-34 tilt=-20 len=0.274 material=DarkGreen frame=up sides=6
      ring 0.00 w=0.08 d=0.026
      ring 0.20 w=0.40 d=0.048
      ring 0.38 w=0.21 d=0.038
      ring 0.58 w=0.43 d=0.048
      ring 0.78 w=0.22 d=0.038
      ring 1.00 w=0.15 d=0.023
      cap start=flat end=dome
    loft lfD bone=ptD at=1.00 dir=side yaw=-86 tilt=-8 len=0.303 material=Green frame=up sides=6
      ring 0.00 w=0.09 d=0.027
      ring 0.20 w=0.43 d=0.050
      ring 0.38 w=0.22 d=0.040
      ring 0.58 w=0.47 d=0.050
      ring 0.78 w=0.24 d=0.040
      ring 1.00 w=0.16 d=0.024
      cap start=flat end=dome
    loft lfE bone=ptA at=0.30 dir=side yaw=44 tilt=64 len=0.279 material=Green frame=up sides=6
      ring 0.00 w=0.07 d=0.024
      ring 0.20 w=0.33 d=0.044
      ring 0.38 w=0.17 d=0.036
      ring 0.58 w=0.36 d=0.044
      ring 0.78 w=0.18 d=0.036
      ring 1.00 w=0.12 d=0.021
      cap start=flat end=dome
  end

  # ---- the blossom ---------------------------------------------------------------
  #
  # A trumpet: narrow at the stalk, flaring at the mouth, open at the end. `cap end=none` is
  # what makes it a trumpet rather than a bud — a closed flower is a yellow egg.
  loft bloom bone=fl at=1.00 dir=up pitch=30 len=0.105 material=Berry sides=7
    ring 0.00 w=0.04 d=0.04
    ring 0.42 w=0.09 d=0.09
    ring 0.78 w=0.15 d=0.15
    ring 1.00 w=0.19 d=0.19
    cap start=flat end=none

checks
  # A TRUMPET: the mouth is much wider than the throat, and it is held clear of the leaves.
  assert width(bloom) > 0.14
  # ...but a SMALL one. This is the assertion that keeps it from becoming the squash's.
  assert width(bloom) < 0.22
  assert top(bloom) > 0.13
  # Sparser in PARTS than the ripe rung — no melon.
  assert parts == 20
  # Must not out-top the ripe rung, or the ordering pass shrinks it.
  assert height in 0.20..0.35
  assert width / height in 2.0..3.9
  assert depth / height < 4.0
  assert bottom(mound) < 0.06
  assert width(lfA.l) > 0.30
  assert tris < 2600
  measure sprawl width / height
