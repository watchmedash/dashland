# Agave, first rung (1 of 4). See `agave_4.wam` for the argument and the rules.
#
# Three blade pairs and nothing else. An agave rosette gains leaves from the middle
# outward over years, so the young plant is genuinely fewer, shorter, steeper blades — not
# the ripe rosette at 40%, which is what a scale ramp would give and what the pack ladder
# it replaces did give.

model agave
  height 1.3
  style chunky

palette
  Wood      #6a8a6a
  Green     #8aa87e
  DarkGreen #74906a
  Berry     #d4c46a

skeleton
  root sand at 0.0
  bone core parent=sand dir=up len=0.06
  mirror
    bone blA parent=core dir=side tilt=44 len=0.22
    bone blB parent=core dir=side yaw=68  tilt=56 len=0.19
    bone blC parent=core dir=side yaw=134 tilt=62 len=0.17
  end

parts
  loft boss bones=sand..core material=Wood sides=8
    ring 0.00 w=0.16 d=0.16
    ring 1.00 w=0.13 d=0.13
    cap start=flat end=flat

  mirror
    loft bladeA bones=blA..blA material=Green frame=up sides=5
      ring 0.00 w=0.085 d=0.042
      ring 0.30 w=0.105 d=0.052
      ring 0.72 w=0.080 d=0.038
      ring 1.00 w=0.014 d=0.008 tip
      cap start=dome end=point
    loft bladeB bones=blB..blB material=DarkGreen frame=up sides=5
      ring 0.00 w=0.078 d=0.039
      ring 0.30 w=0.097 d=0.048
      ring 0.72 w=0.073 d=0.035
      ring 1.00 w=0.013 d=0.008 tip
      cap start=dome end=point
    loft bladeC bones=blC..blC material=Green frame=up sides=5
      ring 0.00 w=0.072 d=0.036
      ring 0.30 w=0.090 d=0.044
      ring 0.72 w=0.068 d=0.032
      ring 1.00 w=0.012 d=0.007 tip
      cap start=dome end=point
  end

checks
  # Steep and small. The ripe rosette lies back to 16 degrees; a young one is a fist.
  assert top(bladeA.l) < 0.24
  assert depth(bladeA.l) / height(bladeA.l) > 0.30
  assert bottom(boss) < 0.02
  assert tris < 400
  measure aspect width / height
