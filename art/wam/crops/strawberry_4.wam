# Strawberry, ripe (rung 4 of 4). THE CONTROL CROP for the WAM pilot.
#
# The other three pilot crops were picked because the audit said they were wrong. This
# one was picked because it is EASY and its current recipe is not obviously broken —
# `nature/BushBerries_*` with the pack's own berries deleted and 11 generated spheres
# scattered on top. If a WAM model cannot beat that, the answer is about the tool; if it
# beats this and the hard ones too, the answer is about the subject.
#
# cropdata silhouette: "Low sprawling leaves with bright red berries hanging clear of the
# foliage." Two things the berry-bush model cannot do: its foliage is a DOME (hence the
# recipe's `squash: 0.62`, which flattens a dome into a flatter dome), and scattered
# spheres sit ON the foliage rather than hanging clear of it on their own stems.
#
# See `icecapmoss_3.wam` for the material-name and no-`textures` rules.

model strawberry
  height 0.30
  style chunky

palette
  Green     #6cc94a
  DarkGreen #4f9438
  Wood      #4f9438
  Berry     #e8425a

skeleton
  # The crown sits UP off the soil and the petioles are steep, which is not botany — it is
  # arithmetic. `familyScale` takes the smaller of (crop height / model height) and (tile
  # width / model width), so a model with a 6:1 width-to-height ratio gets scaled by its
  # WIDTH and arrives at half the height cropdata asked for. Measured: the first cut was
  # 0.34 tall by 1.95 wide in height-fractions, which rendered in-game as a 15 cm flat green
  # mat on green grass, invisible from three metres — worse than the berry bush it replaced.
  # A sprawler still has to stand up to be seen.
  root crown at 0.13
  # Three petiole pairs, splaying out and up: a strawberry is a rosette that sprawls, so
  # the leaves lie nearly flat and reach well past the crown.
  mirror
    # SHORT petioles. The first cut used 0.62 and rendered as a wire tripod with small
    # leaflets on the ends — a spider, not a plant. The leaf mass has to start close to the
    # crown and the leaflets have to be most of the plant's radius.
    bone petA parent=crown dir=side tilt=64 len=0.34
    bone petB parent=crown dir=side yaw=74  tilt=58 len=0.31
    bone petC parent=crown dir=side yaw=142 tilt=62 len=0.32
    bone petD parent=crown dir=side yaw=104 tilt=70 len=0.28
    # The fruiting runners: longer, flatter, and they end OUTSIDE the leaf rosette, which
    # is the whole of "hanging clear of the foliage".
    bone runA parent=crown dir=side yaw=38  tilt=14 len=0.85
    bone runB parent=crown dir=side yaw=166 tilt=11 len=0.80
  end

parts
  # Petioles. Thin, and they exist only so the leaflets are held OFF the crown — a rosette
  # whose leaves start at the centre is a lettuce.
  mirror
    loft stalkA bones=petA..petA material=Wood sides=5
      ring 0.00 w=0.055 d=0.055
      ring 1.00 w=0.038 d=0.038
      cap start=dome end=flat
    loft stalkB bones=petB..petB material=Wood sides=5
      ring 0.00 w=0.050 d=0.050
      ring 1.00 w=0.034 d=0.034
      cap start=dome end=flat
    loft stalkC bones=petC..petC material=Wood sides=5
      ring 0.00 w=0.052 d=0.052
      ring 1.00 w=0.036 d=0.036
      cap start=dome end=flat
    loft stalkD bones=petD..petD material=Wood sides=5
      ring 0.00 w=0.048 d=0.048
      ring 1.00 w=0.032 d=0.032
      cap start=dome end=flat
  end

  # Trifoliate leaves: three leaflets off the end of every petiole, which is the one thing
  # about a strawberry leaf anybody could name. `frame=up` with w WIDE and d THIN, so each
  # leaflet is a flat blade lying face-up.
  mirror
    loft lfA1 bone=petA at=1.00 dir=side tilt=-38 len=0.61 material=Green frame=up sides=5
      ring 0.00 w=0.142 d=0.030
      ring 0.30 w=0.568 d=0.048
      ring 0.72 w=0.596 d=0.044
      ring 1.00 w=0.227 d=0.022
      cap start=flat end=dome
    loft lfA2 bone=petA at=1.00 dir=side yaw=48  tilt=-42 len=0.52 material=DarkGreen frame=up sides=5
      ring 0.00 w=0.128 d=0.028
      ring 0.30 w=0.497 d=0.044
      ring 0.72 w=0.525 d=0.040
      ring 1.00 w=0.199 d=0.020
      cap start=flat end=dome
    loft lfA3 bone=petA at=1.00 dir=side yaw=-48 tilt=-42 len=0.52 material=DarkGreen frame=up sides=5
      ring 0.00 w=0.128 d=0.028
      ring 0.30 w=0.497 d=0.044
      ring 0.72 w=0.525 d=0.040
      ring 1.00 w=0.199 d=0.020
      cap start=flat end=dome
    loft lfB1 bone=petB at=1.00 dir=side yaw=74 tilt=-40 len=0.58 material=DarkGreen frame=up sides=5
      ring 0.00 w=0.142 d=0.030
      ring 0.30 w=0.540 d=0.046
      ring 0.72 w=0.568 d=0.042
      ring 1.00 w=0.213 d=0.021
      cap start=flat end=dome
    loft lfB2 bone=petB at=1.00 dir=side yaw=118 tilt=-44 len=0.49 material=Green frame=up sides=5
      ring 0.00 w=0.128 d=0.028
      ring 0.30 w=0.469 d=0.043
      ring 0.72 w=0.497 d=0.039
      ring 1.00 w=0.185 d=0.020
      cap start=flat end=dome
    loft lfC1 bone=petC at=1.00 dir=side yaw=142 tilt=-40 len=0.59 material=Green frame=up sides=5
      ring 0.00 w=0.142 d=0.030
      ring 0.30 w=0.554 d=0.047
      ring 0.72 w=0.582 d=0.043
      ring 1.00 w=0.227 d=0.021
      cap start=flat end=dome
    loft lfD1 bone=petD at=1.00 dir=side yaw=104 tilt=-42 len=0.54 material=DarkGreen frame=up sides=5
      ring 0.00 w=0.13 d=0.030
      ring 0.30 w=0.53 d=0.048
      ring 0.72 w=0.55 d=0.044
      ring 1.00 w=0.21 d=0.022
      cap start=flat end=dome
    loft lfC2 bone=petC at=1.00 dir=side yaw=186 tilt=-44 len=0.51 material=DarkGreen frame=up sides=5
      ring 0.00 w=0.128 d=0.028
      ring 0.30 w=0.483 d=0.044
      ring 0.72 w=0.511 d=0.040
      ring 1.00 w=0.199 d=0.020
      cap start=flat end=dome
  end

  # The runners, and then the berries hanging off their ends.
  mirror
    loft runstA bones=runA..runA material=Wood sides=5
      ring 0.00 w=0.045 d=0.045
      ring 1.00 w=0.030 d=0.030
      cap start=dome end=flat
    loft runstB bones=runB..runB material=Wood sides=5
      ring 0.00 w=0.042 d=0.042
      ring 1.00 w=0.028 d=0.028
      cap start=dome end=flat
    # `dir=down`: the berry hangs. The recipe this replaces scattered spheres onto the
    # foliage's own vertices, so every berry sat ON a leaf — which is the one thing
    # cropdata's silhouette line explicitly rules out.
    loft berryA bone=runA at=1.00 dir=down pitch=-16 len=0.22 material=Berry sides=7
      ring 0.00 w=0.10 d=0.10
      ring 0.22 w=0.30 d=0.30
      ring 0.58 w=0.28 d=0.28
      ring 1.00 w=0.05 d=0.05 tip
      cap start=dome end=point
    loft berryB bone=runB at=1.00 dir=down pitch=-10 len=0.20 material=Berry sides=7
      ring 0.00 w=0.09 d=0.09
      ring 0.22 w=0.26 d=0.26
      ring 0.58 w=0.24 d=0.24
      ring 1.00 w=0.05 d=0.05 tip
      cap start=dome end=point
  end

checks
  # Low and sprawling: much wider than tall.
  # 3:1, not 6:1 — see the note on the crown height above.
  assert width / height in 2.4..4.2
  assert bottom(stalkA.l) < 0.14
  # The berries hang, but they do not hang INTO the soil — the first cut had them 0.11
  # below the ground plane, i.e. half a strawberry buried.
  assert bottom(berryA.l) > 0.02
  # The berries hang CLEAR of the foliage: further OUT than the leaves reach. The earlier
  # form of this check also demanded they hang below the leaves, which fought the fix for
  # the flatness above — a berry lower than a drooping leaflet is a berry in the soil.
  assert xmax(berryA.l) > xmax(lfA1.l) * 0.95
  # ...and big enough to see on a 30 cm plant.
  assert width(berryA.l) in 0.20..0.40
  # Trifoliate: three leaflets off petiole A, and they reach past the petiole itself.
  assert xmax(lfA1.l) > xmax(stalkA.l)
  assert asymmetry(stalkA.l) < 0.9
  # Budget: `clump: 2` stamps this twice per tile against a 2600-triangle rung budget.
  assert tris < 1500
  measure sprawl width / height
