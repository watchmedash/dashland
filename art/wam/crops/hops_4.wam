# Hops, ripe (rung 4 of 4 — hops has five stages over four models).
#
# cropdata silhouette: "Tallest trellis crop; papery cone-shaped flower clusters in dense
# ropes."
#
# ---- what makes this hops and not the other two trellis vines --------------------
#
# Every clause of that line is a shape, and none of them survived `climbVine`, which gave all
# four trellis crops one generated weave and told them apart by `colors.fruit`:
#
#   - TALLEST. The bine runs to 0.97 of the model's own height with the leaf mass held tight
#     against it, so the plant tops the frame instead of stopping short of it and spreading.
#     Grape asserts width/height in 0.62..0.85 and snow pea 0.42..0.55; this one asserts under
#     0.42, and those three non-touching bands are what stop the silhouettes converging.
#   - A BINE, not a weave. Two shoots twist round the string in a real CORKSCREW: each bone
#     leans thirty degrees toward a different compass point in turn, so the path circles the
#     axis instead of zig-zagging in one plane. `checks` asserts the depth of that spiral is
#     comparable to its width — a planar weave like green bean's reads about 0.47 on the same
#     measure, a corkscrew reads near 1.
#   - CONES, in ROPES. A hop cone is a stepped, papery, pointed ovoid about twice as long as
#     it is wide, and they hang three to a lateral in a vertical string. The rope is the read:
#     three cones stacked down one hanging stalk is a shape, where the fourteen scattered
#     0.030 blobs the old recipe hung were a density.
#
# `world/crops.js` still generates and merges the trellis FRAME around this model — the frame
# belongs to the STYLE — and `ownVine: true` in the recipe is what stops `climbVine` throwing
# the model away. Without the flag a WAM trellis crop compiles, installs, loads, and is then
# silently discarded.
#
# See `icecapmoss_3.wam` for the material-name and no-`textures` rules.

model hops
  height 2.2
  style chunky

palette
  Wood      #5a8a34
  Green     #5c9c38
  DarkGreen #477d2c
  Berry     #a89a44

skeleton
  root ground at 0.0
  # The corkscrew. `dir=up` is a world direction, so these leans do not accumulate: tilt
  # takes the segment toward -X, pitch toward +Z, and cycling tilt/pitch/-tilt/-pitch walks
  # the path around the axis. Two full turns over eight segments.
  #
  # The excursion is 0.125 * sin(30) = 0.063 of the height each way, which on a 2.2 m crop is
  # 14 cm — inside `trellisHalfWidth` (TILE_M * 0.34 = 0.355 m, i.e. 0.161 here), so the bine
  # climbs the frame rather than pushing through it.
  mirror
    # The first two segments lean less than the rest: a bine leaves the ground as one shoot
    # and only opens onto the string as it climbs. At a flat 30 the two mirrored bines splayed
    # into an inverted V at the soil and the plant read as a pair of legs.
    bone c1 parent=ground offset=(0.014,0,0.010) dir=up tilt=-12 len=0.125
    bone c2 parent=c1 dir=up pitch=20  len=0.125
    bone c3 parent=c2 dir=up tilt=30   len=0.125
    bone c4 parent=c3 dir=up pitch=-30 len=0.125
    bone c5 parent=c4 dir=up tilt=-30  len=0.125
    bone c6 parent=c5 dir=up pitch=30  len=0.125
    bone c7 parent=c6 dir=up tilt=30   len=0.125
    bone c8 parent=c7 dir=up pitch=-30 len=0.125

    # The ropes: short laterals hanging off the bine, one per turn. The cones hang ON these,
    # so a rope is a real attached string of fruit rather than three solids floating in a line.
    bone rA parent=c5 at=0.60 dir=down pitch=16 len=0.24
    bone rB parent=c6 at=0.75 dir=down pitch=-12 len=0.22
    bone rC parent=c8 at=0.45 dir=down pitch=20 len=0.20
  end

parts
  mirror
    # One loft through the whole chain, so the bine is continuous round every turn. Thin: a
    # hop bine is a rough green string, and a fat one is a sapling.
    loft bine bones=c1..c8 material=Wood sides=5
      ring 0.00 w=0.026 d=0.026
      ring 0.50 w=0.019 d=0.019
      ring 1.00 w=0.011 d=0.011
      cap start=flat end=dome

    loft ropeA bones=rA..rA material=Wood sides=4
      ring 0.00 w=0.013 d=0.013
      ring 1.00 w=0.007 d=0.007
      cap start=flat end=dome
    loft ropeB bones=rB..rB material=Wood sides=4
      ring 0.00 w=0.012 d=0.012
      ring 1.00 w=0.007 d=0.007
      cap start=flat end=dome
    loft ropeC bones=rC..rC material=Wood sides=4
      ring 0.00 w=0.012 d=0.012
      ring 1.00 w=0.006 d=0.006
      cap start=flat end=dome
  end

  # ---- the leaves ----------------------------------------------------------------
  #
  # Small and held close. A hop leaf is roughly a grape leaf botanically, and making it one
  # here would have thrown away the whole distinction — grape asserts `area > 0.030` on its
  # blade and this one asserts under 0.024, so the two canopies cannot converge. Held on short
  # petioles against the bine, because the narrow silhouette is the species.
  mirror
    loft lfA bone=c2 at=0.60 dir=side yaw=24   tilt=-18 len=0.125 material=Green frame=up sides=5
      ring 0.00 w=0.018 d=0.009
      ring 0.28 w=0.088 d=0.016
      ring 0.68 w=0.104 d=0.014
      ring 1.00 w=0.058 d=0.009
      cap start=flat end=dome
    loft lfB bone=c3 at=0.85 dir=side yaw=-98  tilt=-24 len=0.115 material=DarkGreen frame=up sides=5
      ring 0.00 w=0.017 d=0.009
      ring 0.28 w=0.082 d=0.015
      ring 0.68 w=0.096 d=0.013
      ring 1.00 w=0.054 d=0.009
      cap start=flat end=dome
    loft lfC bone=c4 at=0.55 dir=side yaw=64   tilt=-14 len=0.125 material=DarkGreen frame=up sides=5
      ring 0.00 w=0.018 d=0.009
      ring 0.28 w=0.088 d=0.016
      ring 0.68 w=0.104 d=0.014
      ring 1.00 w=0.058 d=0.009
      cap start=flat end=dome
    loft lfD bone=c5 at=0.80 dir=side yaw=-40  tilt=-28 len=0.115 material=Green frame=up sides=5
      ring 0.00 w=0.017 d=0.009
      ring 0.28 w=0.082 d=0.015
      ring 0.68 w=0.096 d=0.013
      ring 1.00 w=0.054 d=0.009
      cap start=flat end=dome
    loft lfE bone=c6 at=0.50 dir=side yaw=132  tilt=-20 len=0.115 material=Green frame=up sides=5
      ring 0.00 w=0.017 d=0.009
      ring 0.28 w=0.082 d=0.015
      ring 0.68 w=0.096 d=0.013
      ring 1.00 w=0.054 d=0.009
      cap start=flat end=dome
    loft lfF bone=c7 at=0.75 dir=side yaw=-70  tilt=-16 len=0.115 material=DarkGreen frame=up sides=5
      ring 0.00 w=0.017 d=0.009
      ring 0.28 w=0.082 d=0.015
      ring 0.68 w=0.096 d=0.013
      ring 1.00 w=0.054 d=0.009
      cap start=flat end=dome
    loft lfG bone=c8 at=0.60 dir=side yaw=36   tilt=-22 len=0.09 material=Green frame=up sides=5
      ring 0.00 w=0.016 d=0.008
      ring 0.28 w=0.066 d=0.013
      ring 0.68 w=0.078 d=0.011
      ring 1.00 w=0.042 d=0.007
      cap start=flat end=dome
    loft lfH bone=c1 at=0.70 dir=side yaw=-56 tilt=-22 len=0.115 material=DarkGreen frame=up sides=5
      ring 0.00 w=0.017 d=0.009
      ring 0.28 w=0.082 d=0.015
      ring 0.68 w=0.096 d=0.013
      ring 1.00 w=0.054 d=0.009
      cap start=flat end=dome
    loft lfI bone=c7 at=0.35 dir=side yaw=108 tilt=-16 len=0.115 material=Green frame=up sides=5
      ring 0.00 w=0.017 d=0.009
      ring 0.28 w=0.082 d=0.015
      ring 0.68 w=0.096 d=0.013
      ring 1.00 w=0.054 d=0.009
      cap start=flat end=dome
  end

  # ---- the cones -----------------------------------------------------------------
  #
  # PAPERY is a profile, not a texture: the rings step in and out down the cone so the
  # silhouette is a stack of overlapping bracts rather than a smooth spindle. Twice as long as
  # it is wide and drawn to a point at the bottom, which is what tells a hop cone from the
  # grape's shouldered bunch (asserted at three times this width) at any distance.
  #
  # Three to a rope, at 0.18 / 0.52 / 0.86 along it, so they read as a hanging string.
  mirror
    loft cnA1 bone=rA at=0.18 dir=down pitch=4 len=0.078 material=Berry sides=5
      ring 0.00 w=0.014 d=0.014
      ring 0.18 w=0.036 d=0.034
      ring 0.40 w=0.030 d=0.029
      ring 0.62 w=0.034 d=0.032
      ring 0.82 w=0.024 d=0.023
      ring 1.00 w=0.008 d=0.008 tip
      cap start=dome end=point
    loft cnA2 bone=rA at=0.52 dir=down pitch=-6 len=0.078 material=Berry sides=5
      ring 0.00 w=0.014 d=0.014
      ring 0.18 w=0.036 d=0.034
      ring 0.40 w=0.030 d=0.029
      ring 0.62 w=0.034 d=0.032
      ring 0.82 w=0.024 d=0.023
      ring 1.00 w=0.008 d=0.008 tip
      cap start=dome end=point
    loft cnA3 bone=rA at=0.86 dir=down pitch=6 len=0.074 material=Berry sides=5
      ring 0.00 w=0.013 d=0.013
      ring 0.18 w=0.034 d=0.032
      ring 0.40 w=0.028 d=0.027
      ring 0.62 w=0.032 d=0.030
      ring 0.82 w=0.023 d=0.022
      ring 1.00 w=0.008 d=0.008 tip
      cap start=dome end=point
    loft cnB1 bone=rB at=0.20 dir=down pitch=-5 len=0.074 material=Berry sides=5
      ring 0.00 w=0.013 d=0.013
      ring 0.18 w=0.034 d=0.032
      ring 0.40 w=0.028 d=0.027
      ring 0.62 w=0.032 d=0.030
      ring 0.82 w=0.023 d=0.022
      ring 1.00 w=0.008 d=0.008 tip
      cap start=dome end=point
    loft cnB2 bone=rB at=0.55 dir=down pitch=5 len=0.074 material=Berry sides=5
      ring 0.00 w=0.013 d=0.013
      ring 0.18 w=0.034 d=0.032
      ring 0.40 w=0.028 d=0.027
      ring 0.62 w=0.032 d=0.030
      ring 0.82 w=0.023 d=0.022
      ring 1.00 w=0.008 d=0.008 tip
      cap start=dome end=point
    loft cnB3 bone=rB at=0.88 dir=down pitch=-4 len=0.070 material=Berry sides=5
      ring 0.00 w=0.012 d=0.012
      ring 0.18 w=0.032 d=0.030
      ring 0.40 w=0.027 d=0.026
      ring 0.62 w=0.030 d=0.029
      ring 0.82 w=0.022 d=0.021
      ring 1.00 w=0.007 d=0.007 tip
      cap start=dome end=point
    loft cnC1 bone=rC at=0.24 dir=down pitch=6 len=0.070 material=Berry sides=5
      ring 0.00 w=0.012 d=0.012
      ring 0.18 w=0.032 d=0.030
      ring 0.40 w=0.027 d=0.026
      ring 0.62 w=0.030 d=0.029
      ring 0.82 w=0.022 d=0.021
      ring 1.00 w=0.007 d=0.007 tip
      cap start=dome end=point
    loft cnC2 bone=rC at=0.70 dir=down pitch=-6 len=0.068 material=Berry sides=5
      ring 0.00 w=0.012 d=0.012
      ring 0.18 w=0.031 d=0.029
      ring 0.40 w=0.026 d=0.025
      ring 0.62 w=0.029 d=0.028
      ring 0.82 w=0.021 d=0.020
      ring 1.00 w=0.007 d=0.007 tip
      cap start=dome end=point
  end

checks
  assert bottom(bine.l) < 0.02
  # ---- the three numbers that keep hops, grape and snow pea apart -----------------
  #
  # 1. TALLEST, and narrow with it. Grape asserts 0.62..0.85 on this ratio and snow pea
  #    0.42..0.55, so no two of the three can drift into one costume.
  assert width / height < 0.42
  assert top(bine.l) / height > 0.95
  # 2. A CORKSCREW. A planar weave has a depth a fraction of its width; a spiral does not.
  assert depth(bine.l) / width(bine.l) in 0.60..1.60
  # 3. A BINE, not a bole. Grape asserts a trunk over 0.052 wide and its cordons alone reach
  #    0.19 across; the whole lateral span of this one — spiral included — is under 0.12.
  assert width(bine.l) < 0.12
  assert area(lfA.l) < 0.024
  # ---- "papery cone-shaped clusters in dense ropes" -------------------------------
  #
  # Twice as long as wide, and SMALL — grape's bunch asserts width > 0.085 on this measure.
  assert height(cnA1.l) / width(cnA1.l) in 1.7..2.8
  assert width(cnA1.l) < 0.040
  # A ROPE: three cones stacked down one lateral, near-vertically above one another.
  assert y(cnA1.l) - y(cnA3.l) > 0.14
  assert abs(x(cnA1.l) - x(cnA3.l)) < 0.05
  assert abs(z(cnA1.l) - z(cnA3.l)) < 0.05
  # ...and the rope hangs clear of the leaf it grows beside rather than inside it. The ropes
  # are all in the top two thirds: a first pass hung them off c3 and the bottom cone finished
  # 0.004 above the soil, which is a hop cone lying in the dirt.
  assert bottom(cnA3.l) < bottom(lfD.l)
  assert bottom(cnA3.l) > 0.18
  # Budget: footprint 1, so `TRI_BUDGET` = 2600 before the decimator steps in.
  assert tris < 2300
  measure cone height(cnA1.l) / width(cnA1.l)
